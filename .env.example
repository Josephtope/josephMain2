# Public mobile configuration
EXPO_PUBLIC_API_BASE_URL=https://api.example.invalid

# Server runtime
NODE_ENV=development
PORT=3000
PUBLIC_API_ORIGINS=http://localhost:8081,http://localhost:19006

# Railway backend and worker configuration
DATABASE_URL=mysql://user:password@host:3306/database
EXPECTED_SCHEMA_VERSION=phase6-sender-authorization
SESSION_SIGNING_KEY=replace-with-a-long-random-secret-at-least-32-characters
SESSION_KEY_VERSION=v1
SESSION_LIFETIME_SECONDS=604800
AUTH_ISSUER=stealth-mail-studio
AUTH_AUDIENCE=stealth-mail-studio-api
TOKEN_ENCRYPTION_KEY=replace-with-a-dedicated-encryption-key

# Application-login OAuth; use a new HTTPS callback and keep these values backend-only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Exact comma-separated native return URIs; arbitrary redirects are rejected.
NATIVE_RETURN_URI_ALLOWLIST=manusstudio://oauth/callback
OAUTH_STATE_SIGNING_KEY=replace-with-a-dedicated-oauth-state-key-at-least-32-characters
OAUTH_STATE_KEY_VERSION=v1
OAUTH_STATE_LIFETIME_SECONDS=600
LOGIN_EXCHANGE_CODE_LIFETIME_SECONDS=120
GOOGLE_CONNECTION_REDIRECT_URI=

# Never place real values in this file. Real secrets belong in local secret storage or Railway variables.
