# Public mobile configuration
EXPO_PUBLIC_API_BASE_URL=https://api.example.invalid

# Railway backend and worker configuration
DATABASE_URL=mysql://user:password@host:3306/database
SESSION_SIGNING_KEY=replace-with-a-long-random-secret
OAUTH_STATE_SIGNING_KEY=replace-with-a-different-long-random-secret
TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-key
GOOGLE_OAUTH_CLIENT_ID=replace-with-new-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-new-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://new-railway-domain.example/api/auth/google/callback
GOOGLE_CONNECTION_REDIRECT_URI=https://new-railway-domain.example/api/google/oauth/callback
PUBLIC_WEB_ORIGIN_ALLOWLIST=https://new-railway-domain.example
NODE_ENV=development
PORT=3000

# Never place real values in this file. Real secrets belong in the local secret store or Railway variables.
